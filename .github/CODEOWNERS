# Model B UI isolation — see docs/BRANCHING.md
# Two front-end strategies share this repo and must stay in their own trees:
#   web  = src/ + src-tauri/            (Tauri 2 + Svelte 5, ships from main)
#   egui = crates/astroforge-ui + render (native egui+wgpu, parity on egui/main)
# They meet only at astroforge-core / astroforge-ai and the data directory.
# In a multi-team setup, point each section at the owning team instead.

# Web UI (shipping front-end, main)
/src/ @emmanuel-a-otchere
/src-tauri/ @emmanuel-a-otchere
/index.html @emmanuel-a-otchere
/package.json @emmanuel-a-otchere
/package-lock.json @emmanuel-a-otchere
/svelte.config.js @emmanuel-a-otchere
/vite.config.ts @emmanuel-a-otchere
/vitest.config.ts @emmanuel-a-otchere
/vitest.setup.ts @emmanuel-a-otchere
/tsconfig.json @emmanuel-a-otchere
/.prettierrc @emmanuel-a-otchere
/.prettierignore @emmanuel-a-otchere

# Native egui UI (parity branch egui/main)
/crates/astroforge-ui/ @emmanuel-a-otchere
/crates/astroforge-render/ @emmanuel-a-otchere

